    "method": "POST",
    "headers": {
      "Origin": "https://www.lvmh.com",
      "Referer": "https://www.lvmh.com/en/join-us/our-job-offers",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36"
    },
    "body": {
      "queries": [
        {
          "indexName": "PRD-en-us-timestamp-desc",
          "params": {
            "facetFilters": [
              [
                "contractFilter:Permanent Job"
              ],
              [
                "countryRegionFilter:France"
              ]
            ],
            "filters": "category:job",
            "hitsPerPage": 1000,
            "page": 0,
            "query": "",
            "attributesToRetrieve": 
            [
              "name",
              "maison",
              "country",
              "regionState",
              "link",
              "objectID",
              "publicationTimestamp"
            ]
          }
        }
      ]
    },
    "list_path": "results.0.hits",
    "fields": {
      "id": "objectID",
      "title": ["name", "maison"],
      "location": ["regionState", "country"],
      "url": "link",
      "posted": "publicationTimestamp"
    }
  },
